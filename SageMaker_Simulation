import json
import boto3
import os

sagemaker_runtime=boto3.client("sagemaker-runtime")
lambda_client = boto3.client('lambda')

def lambda_handler(event, context):
    try:
        body=event.get('body',event)
        if isinstance(body,str):
            body = json.loads(body)
        
        salary = body.get('salary')
        cibil = body.get('cibil')
        vehicle_model=body.get("vehicle_model")
# Validation
        if not all([salary,cibil,vehicle_model]):
            return{
                "statusCode":400,
                "body":json.dumps({"error":"Missing required fields:salary,cibil or vehicle_modell"})
            }
# Clean processing payload
        sagemaker_payload={
            "salary":float(salary),
            "cibil":int(cibil),
            "vehicle_model":str(vehicle_model)

# STEP 4: Amazon SageMaker Inference
        endpoint_name = os.environ.get('SAGEMAKER_ENDPOINT_NAME','ev-eligibility-endpoint')

        sagemaker_runtime.invoke_endpoint(
            Endpoint=endpoint_name,
            ContentType="application/json"
            Body=json.dumps(sagemaker_payload)
        )

